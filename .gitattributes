*.parquet filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text

# Corrections registry: tiny hand-curated file whose PR diffs ARE the audit
# trail (docs/corrections-plan.md) — keep it a plain text blob, not an LFS
# pointer, so reviews show the actual rows.
data/corrections/*.csv -filter -diff -merge text

# Placeholder recovery's exclusions: six filers, by EIN, each with its
# evidence. Plain text for the same reason as the corrections registry.
# The LFS attributes are reset, not unset: "-diff" would mark the file
# binary and a pull request would hide the row it adds.
data/placeholder_recovery/exclusions.csv !filter !diff !merge text
# The three measurement files committed as plain text under the earlier
# wildcard stay as they are; the placeholder data files moved here from
# data/exploratory on 2026-10-09 stay LFS pointers, as they were.
data/placeholder_recovery/fetch_test_pre2020.csv !filter !diff !merge text
data/placeholder_recovery/renderer_widths.csv !filter !diff !merge text
data/placeholder_recovery/renderer_widths_sample.csv !filter !diff !merge text

# own_extract: the GT column -> xpath mapping. Reviewed by hand, so its diffs
# are the audit trail: not an LFS pointer. Its bytes are kept as written
# (csv's CRLF, no end-of-line conversion) because every load records the
# file's SHA-256 as lineage and reloads a batch when it changes.
data/own_extract/concordance.csv !filter !diff !merge -text
